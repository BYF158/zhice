<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.etsong.mbti.mapper.MbtiRecordMapper">

    <resultMap type="com.etsong.mbti.domain.MbtiRecord" id="MbtiRecordResult">
        <id     property="recordId"    column="record_id"    />
        <result property="userId"      column="user_id"      />
        <result property="userName"    column="user_name"    />
        <result property="resultType"  column="result_type"  />
        <result property="scoreE"      column="score_e"      />
        <result property="scoreI"      column="score_i"      />
        <result property="scoreS"      column="score_s"      />
        <result property="scoreN"      column="score_n"      />
        <result property="scoreT"      column="score_t"      />
        <result property="scoreF"      column="score_f"      />
        <result property="scoreJ"      column="score_j"      />
        <result property="scoreP"      column="score_p"      />
        <result property="duration"    column="duration"     />
        <result property="testTime"    column="test_time"    />
    </resultMap>

    <sql id="selectMbtiRecordVo">
        select record_id, user_id, user_name, result_type, score_e, score_i, score_s, score_n,
               score_t, score_f, score_j, score_p, duration, test_time
        from mbti_records
    </sql>

    <insert id="insertMbtiRecord" parameterType="com.etsong.mbti.domain.MbtiRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into mbti_records
            (user_id, user_name, result_type, score_e, score_i, score_s, score_n,
             score_t, score_f, score_j, score_p, duration, test_time)
        values
            (#{userId}, #{userName}, #{resultType}, #{scoreE}, #{scoreI}, #{scoreS}, #{scoreN},
             #{scoreT}, #{scoreF}, #{scoreJ}, #{scoreP}, #{duration}, #{testTime})
    </insert>

    <select id="selectMbtiRecordById" parameterType="Long" resultMap="MbtiRecordResult">
        <include refid="selectMbtiRecordVo"/>
        where record_id = #{recordId}
    </select>

    <select id="selectMbtiRecordList" parameterType="com.etsong.mbti.domain.MbtiRecord" resultMap="MbtiRecordResult">
        <include refid="selectMbtiRecordVo"/>
        <where>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="userName != null and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="resultType != null and resultType != ''"> and result_type = #{resultType}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and date_format(test_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')</if>
            <if test="params.endTime != null and params.endTime != ''"> and date_format(test_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')</if>
        </where>
        order by record_id desc
    </select>

    <delete id="deleteMbtiRecordByIds" parameterType="Long">
        delete from mbti_records where record_id in
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
</mapper>
